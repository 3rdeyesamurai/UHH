{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": {{#if useEsm}}"ES2022"{{else}}"CommonJS"{{/if}},
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
